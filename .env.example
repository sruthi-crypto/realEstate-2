# ─────────────────────────────────────────────────────────────
# BACKEND — backend-2 (Cloudflare Worker)
# For LOCAL dev: copy to .dev.vars (Wrangler reads this file)
# For PRODUCTION: set these via `wrangler secret put <KEY>`
# NEVER commit real secrets to git.
# ─────────────────────────────────────────────────────────────

# Supabase project URL
# Found at: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase service_role key (NOT the anon key — this bypasses RLS)
# Found at: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_KEY=<your-supabase-service-role-key>

# JWT signing secret — use a long random string (min 32 chars)
# Generate one: openssl rand -base64 32
JWT_SECRET=<your-jwt-secret-min-32-chars>
